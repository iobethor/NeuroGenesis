# NeuroGenesis Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Memory Settings
MEMORY_DB_PATH=./data/memory.db
VECTOR_STORE_PATH=./data/vectors

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Growth Settings
CONSOLIDATION_THRESHOLD=100
DECAY_RATE=0.01
GROWTH_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
