# NeuroGenesis Configuration Example
# Copy this file to .env and modify as needed

# Debug mode
DEBUG=True

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directories
DATA_DIR=./data
MODELS_DIR=./models
LOGS_DIR=./logs

# Optional: API settings (if implementing web API)
# API_HOST=0.0.0.0
# API_PORT=8000

# Optional: Database settings (if needed)
# DATABASE_URL=sqlite:///./neurogenesis.db

# Optional: Model settings
# MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
